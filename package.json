{
  "name": "isl-pcb",
  "productName": "ISL PCB",
  "version": "0.17.0",
  "description": "Schematic capture, circuit simulation and PCB design / Şematik çizim, devre simülasyonu ve PCB tasarımı",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "electron": "electron .",
    "start": "vite build && electron .",
    "pack": "npm run build && node scripts/package.cjs",
    "installer": "npm run pack && \"C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe\" installer\\isl_pcb.iss"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "avr8js": "^0.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rp2040js": "^1.4.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "rcedit": "^5.0.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
