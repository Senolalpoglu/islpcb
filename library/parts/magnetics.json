 {
  "id": "trimpot",
  "label": {
   "en": "Trimmer potentiometer",
   "tr": "Trimpot"
  },
  "category": "passive",
  "prefix": "RV",
  "symbol": {
   "kind": "glyph",
   "glyph": "pot"
  },
  "builtin": true,
  "params": [
   {
    "name": "r",
    "label": {
     "en": "Total resistance (Ω)",
     "tr": "Toplam direnç (Ω)"
    },
    "default": 10000
   },
   {
    "name": "pos",
    "label": {
     "en": "Wiper position (0-1)",
     "tr": "Kayar konumu (0-1)"
    },
    "default": 0.5
   }
  ],
  "model": {
   "elements": [
    {
     "type": "R",
     "nodes": [
      "A",
      "W"
     ],
     "value": "max($r*$pos,0.01)"
    },
    {
     "type": "R",
     "nodes": [
      "W",
      "B"
     ],
     "value": "max($r*(1-$pos),0.01)"
    }
   ]
  },
  "footprint": "SIP_3",
  "padMap": [
   "A",
   "W",
   "B"
  ]
