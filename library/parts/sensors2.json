[
 {
  "id": "mq3-module",
  "label": {
   "en": "MQ-3 alcohol sensor module",
   "tr": "MQ-3 alkol sensörü modülü"
  },
  "category": "sensor",
  "prefix": "U",
  "symbol": {
   "kind": "box",
   "left": [
    "VCC",
    "GND",
    "DO",
    "AO"
   ],
   "right": [],
   "title": "MQ-3"
  },
  "builtin": true,
  "params": [
   {
    "name": "level",
    "label": {
     "en": "Alcohol level (0 clean - 1 heavy)",
     "tr": "Alkol düzeyi (0 temiz - 1 yoğun)"
    },
    "default": 0.2
   },
   {
    "name": "thr",
    "label": {
     "en": "DO threshold trimmer (0-1 of Vcc)",
     "tr": "DO eşik trimpotu (Vcc'nin 0-1'i)"
    },
    "default": 0.5
   }
  ],
  "model": {
   "elements": [
    {
     "type": "R",
     "nodes": [
      "VCC",
      "AO"
     ],
     "value": 10000
    },
    {
     "type": "R",
     "nodes": [
      "AO",
      "GND"
     ],
     "value": "max(10000*$level/(1-min($level,0.99)),1)"
    },
    {
     "type": "R",
     "nodes": [
      "VCC",
      "thr"
     ],
     "value": "max(20000*(1-$thr),1)"
    },
    {
     "type": "R",
     "nodes": [
      "thr",
      "GND"
     ],
     "value": "max(20000*$thr,1)"
    },
    {
     "type": "OA",
     "nodes": [
      "DO",
      "thr",
      "AO"
     ],
     "p": "VCC",
     "n": "GND",
     "props": {
      "headroom": 0.1,
      "headroomLo": 0.02,
      "rout": 100
     }
    },
    {
     "type": "R",
     "nodes": [
      "VCC",
      "GND"
     ],
     "value": 33
    }
   ]
  },
  "footprint": "MOD_SENSOR4",
  "note": "The heater draws about 150 mA from 5 V (33 ohm). AO = Vcc * RL / (Rs + RL) with RL 10 k; DO goes high when AO passes the trimmer threshold. The level is approximate, not calibrated in ppm.",
  "ratings": {
   "v": [
    {
     "a": "VCC",
     "b": "GND",
     "max": 6,
     "min": -0.5,
     "polar": "min"
    }
   ]
  }
 },
